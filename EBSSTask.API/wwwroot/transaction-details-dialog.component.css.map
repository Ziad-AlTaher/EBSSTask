
    .tx-modal-wrapper {
      display: flex;
      flex-direction: column;
      max-height: 85vh;
      background: #ffffff;
      border-radius: 20px;
      overflow: hidden;
    }

    .modal-header {
      padding: 20px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .modal-header-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .modal-icon-tile {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background-color: #E6EFF8;
      color: #0F4C81;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-icon-tile mat-icon {
      font-size: 24px;
      width: 24px;
      height: 24px;
    }

    .modal-title-col {
      display: flex;
      flex-direction: column;
    }

    .modal-title {
      margin: 0;
      font-size: 1.25rem;
      font-weight: 700;
      color: #0F2A43;
      line-height: 1.2;
    }

    .modal-subtitle {
      font-size: 0.82rem;
      color: #64748B;
      line-height: 1.3;
    }

    .btn-modal-close {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background-color: #F1F4F8;
      border: none;
      color: #475569;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }

    .btn-modal-close:hover {
      background-color: #E2E8F0;
      color: #1E293B;
    }

    .btn-modal-close mat-icon {
      font-size: 20px;
      width: 20px;
      height: 20px;
    }

    .modal-divider {
      height: 1px;
      background-color: #E3E7EC;
      width: 100%;
      flex-shrink: 0;
    }

    .modal-body-scroll {
      padding: 20px 24px;
      overflow-y: auto;
      max-height: calc(85vh - 160px);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* 4 Mini Cards */
    .metrics-cards-container {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .metrics-row-top {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .mini-card {
      padding: 14px 16px;
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .card-debit {
      background-color: #EBF3FF;
    }

    .card-credit {
      background-color: #FFF3E8;
    }

    .card-prev {
      background-color: #F1F4F8;
    }

    .card-new-balance {
      background-color: #0F2A43;
      padding: 16px 20px;
    }

    .mini-label {
      font-size: 0.78rem;
      font-weight: 500;
      color: #4F5D6B;
    }

    .mini-value {
      font-size: 1.35rem;
      font-weight: 600;
      line-height: 1.2;
    }

    .color-debit {
      color: #1A4FAE;
    }

    .color-credit {
      color: #A84A00;
    }

    .color-prev {
      color: #33414E;
    }

    .label-new-dark {
      color: rgba(255, 255, 255, 0.75);
    }

    .value-new-dark {
      color: #ffffff;
      font-size: 1.45rem;
    }

    /* Grouped Information Boxes */
    .details-section-box {
      border: 1px solid #E3E7EC;
      border-radius: 12px;
      padding: 16px 20px;
      background-color: #ffffff;
    }

    .section-box-title {
      margin: 0 0 12px 0;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #4F5D6B;
    }

    .kv-rows-list {
      display: flex;
      flex-direction: column;
    }

    .kv-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #F1F4F8;
      font-size: 0.88rem;
    }

    .kv-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .kv-row:first-child {
      padding-top: 0;
    }

    .kv-label {
      color: #4F5D6B;
      font-weight: 400;
    }

    .kv-value {
      color: #1E293B;
      font-weight: 500;
    }

    .remarks-html-box {
      font-size: 0.88rem;
      color: #33414E;
      line-height: 1.5;
      padding-top: 4px;
    }

    .modal-footer {
      padding: 16px 24px;
      display: flex;
      justify-content: flex-end;
      flex-shrink: 0;
    }

    .btn-modal-action-close {
      height: 42px;
      padding: 0 24px;
      border-radius: 12px;
      background-color: #0F4C81;
      color: #ffffff;
      font-size: 0.92rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }

    .btn-modal-action-close:hover {
      background-color: #0a365c;
    }

    .mt-3 {
      margin-top: 12px;
    }
  